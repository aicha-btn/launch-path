# Copier vers .env.local, puis remplir avec les valeurs de `supabase status`.
# Ce fichier-ci est le seul .env versionné : il documente les clés attendues,
# jamais leurs valeurs.

# Connexion directe à Postgres — utilisée par Drizzle et par le serveur.
# En local, la valeur est déterministe (voir docs/setup.md).
DATABASE_URL=

# Client Supabase — uniquement pour l'authentification.
# La clé anon est PUBLIQUE par nature : elle part dans le bundle navigateur.
# C'est précisément pourquoi toutes les tables activent RLS en deny-all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret protégeant la route de rappels quotidiens.
# Générer avec : openssl rand -hex 32
CRON_SECRET=
